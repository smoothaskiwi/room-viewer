{
  "name": "room-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "A measured, accessible static three.js room study",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/test-suite.mjs",
    "verify": "node tools/explorer-browser.mjs --screenshots && node tools/activity-browser.mjs --screenshots",
    "rental:ingest": "node tools/rental-build.mjs",
    "test:postbuild": "node tools/test-suite.mjs postbuild",
    "test:quick": "node tools/test-suite.mjs quick",
    "test:legacy": "node tools/test-suite.mjs legacy"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@flatten-js/core": "1.6.15",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.14.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "25.17.0"
  }
}
